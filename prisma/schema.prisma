generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A competition is one round of predictions (e.g. Round of 16) with its own
/// players, predictions and leaderboard. Rounds are linked into a group via
/// `parentId`: the first round is the group root (parentId null) and later
/// rounds point at it. The whole group shares the root's `adminToken`.
model Competition {
  id         String   @id @default(cuid())
  name       String
  joinCode     String    @unique
  adminToken   String    @unique @default(cuid())
  round        String    @default("Round of 32")
  createdAt    DateTime  @default(now())
  // When live data was last pulled for this competition (throttles auto-sync).
  lastSyncedAt DateTime?

  // Group link: null for the first round, otherwise the root round's id.
  parentId String?
  parent   Competition?  @relation("Rounds", fields: [parentId], references: [id], onDelete: Cascade)
  rounds   Competition[] @relation("Rounds")

  players Player[]
  matches Match[]

  @@index([parentId])
}

/// A player is an identity scoped to a single competition. There is no
/// password: the browser keeps `sessionToken` in a cookie to recognise a
/// returning player.
model Player {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  sessionToken  String   @unique @default(cuid())
  createdAt     DateTime @default(now())

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  predictions Prediction[]

  @@unique([competitionId, name])
  @@index([competitionId])
}

enum MatchStatus {
  SCHEDULED
  IN_PLAY
  FINISHED
}

/// A single fixture in the round being predicted. Belongs to a competition so
/// each group can curate exactly which matches are in play.
model Match {
  id            String      @id @default(cuid())
  competitionId String
  externalId    String? // football-data.org match id, when synced
  stage         String      @default("ROUND_OF_32")
  isKnockout    Boolean     @default(true)
  homeTeam      String
  awayTeam      String
  homeCrest     String?
  awayCrest     String?
  kickoff       DateTime
  status        MatchStatus @default(SCHEDULED)

  // Result after 90 minutes (regular time). This is what scoring uses for the
  // exact-score and goal-difference points.
  homeScore Int?
  awayScore Int?
  // Final result including extra time / penalties — for display only.
  finalHomeScore Int?
  finalAwayScore Int?
  // How the tie was settled: "REGULAR" | "EXTRA_TIME" | "PENALTIES".
  decidedBy String?
  // Which side ultimately qualified / advanced (may be decided on penalties).
  qualifier String? // "HOME" | "AWAY"

  predictions Prediction[]

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, externalId])
  @@index([competitionId])
}

/// One player's prediction for one match.
model Prediction {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  homeScore Int
  awayScore Int
  qualifier String? // "HOME" | "AWAY" — only meaningful for knockout matches
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
}
