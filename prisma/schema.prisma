generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A competition is a private group of friends. Friends join with `joinCode`
/// and the creator manages it with the secret `adminToken`.
model Competition {
  id         String   @id @default(cuid())
  name       String
  joinCode   String   @unique
  adminToken String   @unique @default(cuid())
  round      String   @default("Round of 32")
  createdAt  DateTime @default(now())

  players Player[]
  matches Match[]
}

/// A player is an identity scoped to a single competition. There is no
/// password: the browser keeps `sessionToken` in a cookie to recognise a
/// returning player.
model Player {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  sessionToken  String   @unique @default(cuid())
  createdAt     DateTime @default(now())

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  predictions Prediction[]

  @@unique([competitionId, name])
  @@index([competitionId])
}

enum MatchStatus {
  SCHEDULED
  IN_PLAY
  FINISHED
}

/// A single fixture in the round being predicted. Belongs to a competition so
/// each group can curate exactly which matches are in play.
model Match {
  id            String      @id @default(cuid())
  competitionId String
  externalId    String? // football-data.org match id, when synced
  stage         String      @default("ROUND_OF_32")
  isKnockout    Boolean     @default(true)
  homeTeam      String
  awayTeam      String
  homeCrest     String?
  awayCrest     String?
  kickoff       DateTime
  status        MatchStatus @default(SCHEDULED)

  // Result, after 90 minutes (regular time).
  homeScore Int?
  awayScore Int?
  // Which side ultimately qualified / advanced (may be decided on penalties).
  qualifier String? // "HOME" | "AWAY"

  predictions Prediction[]

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, externalId])
  @@index([competitionId])
}

/// One player's prediction for one match.
model Prediction {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  homeScore Int
  awayScore Int
  qualifier String? // "HOME" | "AWAY" — only meaningful for knockout matches
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
}
