# --- Database -------------------------------------------------------------
# Any Postgres connection string. On Vercel use Vercel Postgres / Neon and it
# will populate this for you. For local dev you can run Postgres in Docker:
#   docker run -e POSTGRES_PASSWORD=pw -p 5432:5432 -d postgres
DATABASE_URL="postgresql://user:password@localhost:5432/worldcup?schema=public"

# --- Live World Cup data (optional) --------------------------------------
# Free API token from https://www.football-data.org/client/register
# When set, admins can sync fixtures/results from football-data.org.
# Leave blank to run in fully-manual mode (admin enters matches & scores).
FOOTBALL_DATA_TOKEN=""

# Competition code on football-data.org. "WC" = FIFA World Cup.
FOOTBALL_DATA_COMPETITION="WC"
